  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default action: paper slip with a sepia border; olive tint on hover, dashed when disabled.",
      "html": "<button class=\"ds-btn\">Export record</button> <button class=\"ds-btn\" disabled>Not available</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:7px 14px;border-radius:5px;border:1px solid var(--rule-strong);background:var(--slip);color:var(--ink);font:600 0.9375rem var(--font-ui);cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-btn:hover:not(:disabled){border-color:var(--olive-line);background:var(--olive-tint)}.ds-btn:focus-visible{outline:2px solid var(--olive-line);outline-offset:2px}.ds-btn:disabled{color:var(--ink-3);border-style:dashed;cursor:not-allowed}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one committed action on a surface, in pressed-leaf olive.",
      "html": "<button class=\"ds-btn-primary\">Open the expert view</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:38px;padding:7px 14px;border-radius:5px;border:1px solid var(--olive);background:var(--olive);color:var(--olive-ink);font:600 0.9375rem var(--font-ui);cursor:pointer;transition:background-color 160ms ease-out}.ds-btn-primary:hover{background:var(--olive-deep)}.ds-btn-primary:focus-visible{outline:2px solid var(--olive-line);outline-offset:2px}"
    },
    {
      "name": "Verdict Chips",
      "kind": "chip",
      "refersTo": "chip-ok",
      "description": "Outline chips; state is carried by border form as well as colour. Red only on critical.",
      "html": "<span class=\"ds-chip ok\">passed</span> <span class=\"ds-chip warn\">caution</span> <span class=\"ds-chip crit\">critical</span> <span class=\"ds-chip na\">not applicable</span> <span class=\"ds-chip unrec\">not recorded</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;padding:2px 8px;border-radius:3px;border:1px solid var(--rule-strong);font:600 0.8125rem var(--font-ui);white-space:nowrap}.ds-chip.ok{color:var(--olive-line);border-color:var(--olive-line)}.ds-chip.warn{color:var(--ochre);border-color:var(--ochre)}.ds-chip.crit{color:var(--stamp);border-color:var(--stamp)}.ds-chip.na{color:var(--ink-2);border-style:dashed}.ds-chip.unrec{color:var(--ink-3);border-style:dotted;font-style:italic}"
    },
    {
      "name": "Line-form glyphs",
      "kind": "custom",
      "refersTo": null,
      "description": "State as line form: solid used, dashed held back, crossed removed, doubled decisive.",
      "html": "<span class=\"ds-lf\"><svg viewBox=\"0 0 26 10\"><line x1=\"1\" y1=\"5\" x2=\"25\" y2=\"5\"/></svg>used</span> <span class=\"ds-lf\"><svg viewBox=\"0 0 26 10\"><line x1=\"1\" y1=\"5\" x2=\"25\" y2=\"5\" stroke-dasharray=\"4 3\"/></svg>held back</span> <span class=\"ds-lf\"><svg viewBox=\"0 0 26 10\"><line x1=\"1\" y1=\"5\" x2=\"25\" y2=\"5\"/><line x1=\"9\" y1=\"1\" x2=\"17\" y2=\"9\"/><line x1=\"17\" y1=\"1\" x2=\"9\" y2=\"9\"/></svg>removed</span> <span class=\"ds-lf\"><svg viewBox=\"0 0 26 10\"><line x1=\"1\" y1=\"3\" x2=\"25\" y2=\"3\"/><line x1=\"1\" y1=\"7\" x2=\"25\" y2=\"7\"/></svg>decisive</span>",
      "css": ".ds-lf{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;font:0.8125rem var(--font-ui);color:var(--ink)}.ds-lf svg{width:26px;height:10px;flex:none}.ds-lf svg line{stroke:currentColor;stroke-width:1.6}"
    },
    {
      "name": "Determination slip",
      "kind": "card",
      "refersTo": "determination-slip",
      "description": "The signature: heading is the result, a mono Det. line below, fields on sepia hairlines.",
      "html": "<article class=\"ds-slip\"><h1>A plain-words determination</h1><p class=\"ds-det\"><span>Det. AILSA agents</span><span>constitution only</span></p><p class=\"ds-lede\">One sentence on what the spectra point to.</p><section class=\"ds-field\"><h2>How sure <a class=\"ds-why\" href=\"#\">why?</a></h2><p>The agents' own rating, attributed as theirs.</p></section></article>",
      "css": ".ds-slip{background:var(--slip);border:1px solid var(--rule-strong);border-radius:3px;padding:22px 24px 18px;display:grid;gap:18px;color:var(--ink);font:0.9375rem/1.5 var(--font-ui);max-width:460px}.ds-slip h1{margin:0;font-size:1.95rem;font-weight:650;line-height:1.15;letter-spacing:-0.02em}.ds-det{margin:0;font:500 0.8125rem/1.45 var(--font-mono);color:var(--ink-2);display:flex;flex-wrap:wrap;gap:2px 12px}.ds-lede{margin:0;font-size:1.125rem;line-height:1.45}.ds-field{border-top:1px solid var(--rule);padding-top:12px}.ds-field h2{margin:0 0 6px;font-size:0.9375rem;font-weight:650;display:flex;justify-content:space-between}.ds-field p{margin:0}.ds-why{font-size:0.8125rem;font-weight:600;color:var(--olive-line);text-decoration-color:var(--rule-strong);text-underline-offset:0.2em}.ds-why:hover{text-decoration-color:currentColor}"
    },
    {
      "name": "Accession label",
      "kind": "card",
      "refersTo": "accession-label",
      "description": "Ruled key-value facts with typed small-caps labels beside each field.",
      "html": "<div class=\"ds-acc\"><dl><dt>Spectra</dt><dd>1H, 13C, HSQC, HMBC</dd><dt>Data sent to</dt><dd>model provider</dd></dl></div>",
      "css": ".ds-acc{border:1px solid var(--rule-strong);border-radius:3px;font:0.8125rem var(--font-ui);color:var(--ink)}.ds-acc dl{margin:0;display:grid;grid-template-columns:max-content 1fr}.ds-acc dt,.ds-acc dd{margin:0;padding:7px 14px;border-top:1px solid var(--rule)}.ds-acc dt:first-of-type,.ds-acc dd:first-of-type{border-top:0}.ds-acc dt{color:var(--ink-2);font-variant-caps:all-small-caps;letter-spacing:0.07em;font-weight:600}"
    },
    {
      "name": "Register",
      "kind": "custom",
      "refersTo": "register-head",
      "description": "Ledger table: sticky small-caps head, tabular numbers, selected rows olive tint, removed rows struck in Ink 2.",
      "html": "<table class=\"ds-reg\"><thead><tr><th>Atom</th><th class=\"num\">Shift</th><th>Status</th></tr></thead><tbody><tr class=\"sel\"><th>C1</th><td class=\"num\">00.0</td><td>used</td></tr><tr class=\"struck\"><th>C2</th><td class=\"num\">00.0</td><td class=\"status\">removed</td></tr></tbody></table>",
      "css": ".ds-reg{border-collapse:collapse;font:0.8125rem var(--font-ui);font-variant-numeric:tabular-nums;color:var(--ink);background:var(--slip);border:1px solid var(--rule)}.ds-reg th,.ds-reg td{padding:7px 10px;border-bottom:1px solid var(--rule);text-align:left}.ds-reg thead th{background:var(--paper-sunk);font-variant-caps:all-small-caps;letter-spacing:0.06em;font-weight:650;color:var(--ink-2)}.ds-reg .num{text-align:right}.ds-reg tr.sel>*{background:var(--olive-tint)}.ds-reg tr.struck>*:not(.status){text-decoration:line-through;text-decoration-color:var(--ink-2);color:var(--ink-2)}"
    },
    {
      "name": "Expert rail",
      "kind": "nav",
      "refersTo": "rail",
      "description": "Olive-deep section rail; the current item inverts. Becomes a horizontal sticky strip at phone width.",
      "html": "<nav class=\"ds-rail\"><button aria-current=\"true\">Result</button><button>Spectra</button><button>Constraints</button></nav>",
      "css": ".ds-rail{display:grid;gap:2px;width:220px;background:var(--olive-deep);border-radius:3px;padding:14px 8px}.ds-rail button{display:flex;align-items:center;text-align:left;border:0;background:transparent;color:var(--olive-ink-2);padding:9px 12px;border-radius:4px;min-height:40px;font:550 0.9375rem var(--font-ui);cursor:pointer}.ds-rail button:hover{background:oklch(100% 0 0 / 0.08);color:var(--olive-ink)}.ds-rail button:focus-visible{outline:2px solid var(--olive-line);outline-offset:2px}.ds-rail button[aria-current=true]{background:var(--olive-ink);color:var(--olive-deep);font-weight:650}"
    },
