  "additionalProperties": false,
  "properties": {
    "blind": {
      "title": "Blind",
      "type": "boolean"
    },
    "dataset_fingerprint": {
      "title": "Dataset Fingerprint",
      "type": "string"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/ExperimentEntry"
      },
      "title": "Experiments",
      "type": "array"
    },
    "jcamp_files": {
      "items": {
        "$ref": "#/$defs/JcampFile"
      },
      "title": "Jcamp Files",
      "type": "array"
    },
    "schema": {
      "const": "ailsa.experiment-inventory",
      "default": "ailsa.experiment-inventory",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "unreadable": {
      "default": 0,
      "minimum": 0,
      "title": "Unreadable",
      "type": "integer"
    }
  },
  "required": [
    "dataset_fingerprint",
    "blind"
  ],
  "title": "ExperimentInventory",
  "type": "object"
}
