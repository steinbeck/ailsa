        "processed": {
          "default": false,
          "title": "Processed",
          "type": "boolean"
        },
        "pulse_program": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pulse Program"
        },
        "raw": {
          "default": false,
          "title": "Raw",
          "type": "boolean"
        },
        "readable": {
          "default": true,
          "title": "Readable",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "scans": {
          "anyOf": [
            {
              "type": "integer"
