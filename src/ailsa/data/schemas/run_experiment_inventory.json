        "sfo1_mhz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sfo1 Mhz"
        },
        "solvent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
