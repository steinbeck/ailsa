      "required": [
        "id"
      ],
      "title": "ExperimentEntry",
      "type": "object"
    },
    "JcampFile": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "additionalProperties": true,
          "title": "Headers",
          "type": "object"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "JcampFile",
      "type": "object"
    },
    "NusInfo": {
