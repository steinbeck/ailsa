            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factor"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "file",
        "shape"
      ],
      "title": "LevelFile",
      "type": "object"
    },
    "ProjectionFile": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "title": "Axis",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "axis",
        "file"
      ],
      "title": "ProjectionFile",
      "type": "object"
    },
    "Quantisation": {
      "additionalProperties": false,
      "properties": {
        "method": {
