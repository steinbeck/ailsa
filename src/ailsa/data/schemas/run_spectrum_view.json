        "type": "integer"
      },
      "title": "Points",
      "type": "array"
    },
    "ppm_end": {
      "items": {
        "type": "number"
      },
      "title": "Ppm End",
      "type": "array"
    },
    "ppm_start": {
      "items": {
        "type": "number"
      },
      "title": "Ppm Start",
      "type": "array"
    },
    "projections": {
